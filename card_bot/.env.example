# Скопируйте этот файл в card_bot/.env и впишите свои значения.

# Токен бота от @BotFather (обязательно)
CARD_BOT_TOKEN=123456789:AA...

# Ваш Telegram ID (узнать: @userinfobot). Пусто — владельцем станет первый, кто нажмёт /start.
ADMIN_IDS=

# Как подписывать карточки (всё это можно поменять и в самом боте: /shop, /contact, /currency, /channel)
SHOP_NAME=MY SHOP
SHOP_CONTACT=@my_username
CURRENCY=сум
# Канал для кнопки «Опубликовать» — бот должен быть администратором канала
CHANNEL_ID=@my_channel

# Модель удаления фона: birefnet-general-lite (аккуратнее) или isnet-general-use (в 2–3 раза быстрее)
REMBG_MODEL=birefnet-general-lite

# Необязательно: Claude читает название со скриншота и пишет продающий текст поста
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
